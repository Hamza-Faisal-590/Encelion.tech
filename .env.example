# =============================================================================
# ENCELION.TECH — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# =============================================================================

# ─────────────── App URLs ───────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# ─────────────── Database ───────────────
# PostgreSQL 16 with pgvector extension
DATABASE_URL="postgresql://postgres:password@localhost:5432/encelion?schema=public"
# Direct connection (for Prisma migrations, bypasses pooler)
DIRECT_URL="postgresql://postgres:password@localhost:5432/encelion?schema=public"

# ─────────────── Redis ───────────────
REDIS_URL="redis://localhost:6379"

# ─────────────── Auth / JWT ───────────────
# Generate with: openssl rand -base64 64
JWT_SECRET="change-me-in-production-very-long-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
# Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-session-secret"

# ─────────────── Google OAuth ───────────────
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# ─────────────── OpenAI ───────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_ORG_ID=
# Default model for agent chat
OPENAI_CHAT_MODEL=gpt-4o
# Fallback / cheaper model
OPENAI_FAST_MODEL=gpt-4o-mini
# Embedding model
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# TTS voice: alloy | echo | fable | onyx | nova | shimmer
OPENAI_TTS_VOICE=nova
OPENAI_TTS_MODEL=tts-1-hd
# STT model
OPENAI_STT_MODEL=whisper-1

# ─────────────── Anthropic (Fallback AI) ───────────────
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ─────────────── ElevenLabs (Premium TTS — optional) ───────────────
# https://elevenlabs.io/
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ─────────────── Deepgram (Streaming STT — optional) ───────────────
# https://console.deepgram.com/
DEEPGRAM_API_KEY=

# ─────────────── Stripe ───────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe Price IDs — created after seeding plans
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...

# ─────────────── Cloudflare R2 (Storage) ───────────────
# https://dash.cloudflare.com/ → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=encelion-assets
R2_PUBLIC_URL=https://assets.encelion.tech

# ─────────────── Resend (Email) ───────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_...
RESEND_FROM_ADDRESS=noreply@encelion.tech
RESEND_REPLY_TO=hello@encelion.tech

# ─────────────── PostHog (Analytics) ───────────────
# https://app.posthog.com/
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─────────────── Sentry (Error Tracking) ───────────────
# https://sentry.io/
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=encelion
SENTRY_PROJECT=encelion-web

# ─────────────── NextAuth ───────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET="change-me-nextauth-secret-very-long"

# ─────────────── Admin App ───────────────
ADMIN_SECRET_KEY="change-me-admin-secret"
